# App
NODE_ENV=development
APP_NAME=Island Empires
APP_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_BASE_URL=http://localhost:5174
API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
VITE_API_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SUPPORT_EMAIL=support@islandempires.local
VITE_MAINTENANCE_MODE=false
APP_VERSION=0.0.1
COMMIT_SHA=local
MAINTENANCE_MODE=false

# API
API_PORT=3000
SESSION_SECRET=
SESSION_COOKIE_NAME=island_empires_session
AUTH_SESSION_COOKIE_NAME=island_empires_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_DEV_MODE=false
ADMIN_SEED_EMAIL=admin@islandempires.local
ADMIN_SEED_ROLE=super_admin

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/island_empires

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=island-empires
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=<local-minio-secret>
S3_BUCKET=island-empires

# Email
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Island Empires <no-reply@islandempires.local>"

# Browser Push
VITE_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:no-reply@islandempires.local
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:no-reply@islandempires.local

# Payments
PAYMENT_PROVIDER=mock_provider
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENTS_PROVIDER=mock_provider
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret
PAYMENTS_MOCK_CHECKOUT_BASE_URL=https://payment-provider.example/checkout

# Supporter donations use hosted checkout and webhook fulfillment only.
# Paid packs must stay cosmetic/supporter-only; gameplay resource and unit packs are earned in-game.

# Observability
ERROR_TRACKING_DSN=
LOG_LEVEL=debug
SUPPORT_EMAIL=support@islandempires.local

# Game
DEFAULT_WORLD_SPEED=1

# Security
RATE_LIMIT_ENABLED=true
