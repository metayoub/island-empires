generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  displayName         String
  isAdmin             Boolean   @default(false)
  adminRole           String    @default("viewer")
  emailVerifiedAt     DateTime?
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  showProfile         Boolean   @default(true)
  accountStatus       String    @default("active")
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                Session[]
  accountRiskSignals      AccountRiskSignal[]
  sensitiveActionAuditLogs SensitiveActionAuditLog[]
  actionFrequencyCounters ActionFrequencyCounter[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  players                 Player[]
  browserPushSubscriptions BrowserPushSubscription[]
  adminRoles               AdminRole[]       @relation("AdminRoleUser")
  adminRolesGranted        AdminRole[]       @relation("AdminRoleGrantedBy")
  adminActionLogs         AdminActionLog[]
  adminPlayerNotes        AdminPlayerNote[]
  adminPlayerNotesForUser AdminPlayerNote[] @relation("AdminNoteTargetUser")
  adminPlayerWarnings     AdminPlayerWarning[]
  moderationActionsForUser PlayerModerationAction[] @relation("ModerationTargetUser")
  moderationActionsByAdmin PlayerModerationAction[] @relation("ModerationAdminUser")
  moderationActionsRevoked PlayerModerationAction[] @relation("ModerationRevokedByUser")
  premiumPurchases        PremiumPurchase[]
  premiumRefunds          PremiumRefund[]
  premiumAuditLogs        PremiumAuditLog[]
  premiumLedgerEntries    PremiumLedgerEntry[]
  cosmeticInventoryItems  CosmeticInventoryItem[]
  inventoryItems          UserInventoryItem[]
  inventoryTransactions   InventoryTransaction[]
  equippedCosmetics       EquippedCosmetic[]
  supporterDonations      SupporterDonation[]
  donationAuditLogs       DonationAuditLog[]
  donationRefundRecords   DonationRefundRecord[]
  betaInviteUsages        BetaInviteUsage[]
  betaAllowlistUsages     BetaAllowlistUsage[]
  betaFeedback            BetaFeedback[]

  @@index([email])
  @@index([isAdmin])
  @@index([adminRole])
  @@index([accountStatus])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model World {
  id            String   @id @default(uuid())
  name          String
  status        String   @default("development")
  speedBuilding Float    @default(1)
  speedResearch Float    @default(1)
  speedResource Float    @default(1)
  speedTravel   Float    @default(1)
  openedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  players                   Player[]
  islands                   Island[]
  cities                    City[]
  transactions              ResourceTransaction[]
  reports                   Report[]
  messages                  Message[]
  notificationDeliveries    NotificationDelivery[]
  messageReports            MessageReport[]
  playerBlocks              PlayerBlock[]
  movements                 Movement[]
  researchStates            PlayerResearchState[]
  playerTechnologies        PlayerTechnology[]
  researchJobs              ResearchJob[]
  researchPointTransactions ResearchPointTransaction[]
  questProgress             PlayerQuestProgress[]
  onboardingStates          PlayerOnboardingState[]
  pveCamps                  PveCamp[]
  playerPveCampProgress     PlayerPveCampProgress[]
  unitTrainingOrders        UnitTrainingOrder[]
  citySpyStates             CitySpyState[]
  spyTrainingJobs           SpyTrainingJob[]
  cityFleets                CityFleet[]
  navalTrainingJobs         NavalTrainingJob[]
  navalAttacks              NavalAttack[]
  cityBlockades             CityBlockade[]
  navalCooldowns            NavalCooldown[]
  spyMissions               SpyMission[]
  spyCooldowns              SpyCooldown[]
  analyticsEvents           GameAnalyticsEvent[]
  marketplaceOffers         MarketplaceOffer[]
  tradeHistories            TradeHistory[]
  suspiciousTradeLogs       SuspiciousTradeLog[]
  alliances                 Alliance[]
  allianceMembers           AllianceMember[]
  allianceApplications      AllianceApplication[]
  allianceInvitations       AllianceInvitation[]
  allianceChatMessages      AllianceChatMessage[]
  allianceAnnouncements     AllianceAnnouncement[]
  allianceTreasuries        AllianceTreasury[]
  allianceDonations         AllianceDonation[]
  allianceProjects          AllianceProject[]
  allianceProjectContributions AllianceProjectContribution[]
  allianceBonuses           AllianceBonus[]
  allianceHelpRequests      AllianceHelpRequest[]
  allianceTradeRequests     AllianceTradeRequest[]
  allianceSharedBattleReports AllianceSharedBattleReport[]
  allianceActivityEntries   AllianceActivityEntry[]
  notificationPreferences   NotificationPreference[]
  browserPushSubscriptions  BrowserPushSubscription[]
  liveEvents                LiveEvent[]
  liveEventParticipations   LiveEventParticipation[]
  playerModerations         PlayerModeration[]
  playerModerationActions   PlayerModerationAction[]
  abuseSignals              AbuseSignal[]
  sensitiveActionAuditLogs  SensitiveActionAuditLog[]
  actionFrequencyCounters   ActionFrequencyCounter[]
  adminActionLogs           AdminActionLog[]
  adminPlayerNotes          AdminPlayerNote[]
  adminPlayerWarnings       AdminPlayerWarning[]
  premiumWallets            PlayerPremiumWallet[]
  premiumPurchases          PremiumPurchase[]
  premiumEntitlements       PremiumEntitlement[]
  premiumRefunds            PremiumRefund[]
  premiumAuditLogs          PremiumAuditLog[]
  premiumLedgerEntries      PremiumLedgerEntry[]
  cosmeticInventoryItems    CosmeticInventoryItem[]
  betaFeedback              BetaFeedback[]
  betaMetricSnapshots       BetaMetricSnapshot[]

  @@unique([name])
}

model Island {
  id             String   @id @default(uuid())
  worldId        String
  x              Int
  y              Int
  name           String?
  mainResource   String
  luxuryResource String
  maxSlots       Int      @default(12)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  world    World     @relation(fields: [worldId], references: [id])
  cities   City[]
  pveCamps PveCamp[]

  @@unique([worldId, x, y])
  @@index([worldId])
  @@index([x, y])
}

model Player {
  id             String   @id @default(uuid())
  userId         String
  worldId        String
  name           String
  score          Int      @default(0)
  selectedCityId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                      User                       @relation(fields: [userId], references: [id])
  world                     World                      @relation(fields: [worldId], references: [id])
  cities                    City[]
  transactions              ResourceTransaction[]
  reports                   Report[]
  notificationPreference    NotificationPreference?
  notificationDeliveries    NotificationDelivery[]
  browserPushSubscriptions  BrowserPushSubscription[]
  sentMessages              Message[]                  @relation("SentPlayerMessages")
  receivedMessages          Message[]                  @relation("ReceivedPlayerMessages")
  blockedPlayers            PlayerBlock[]              @relation("BlockedPlayers")
  blockedByPlayers          PlayerBlock[]              @relation("BlockedPlayersTarget")
  messageReports            MessageReport[]
  movements                 Movement[]
  researchState             PlayerResearchState?
  technologies              PlayerTechnology[]
  researchJobs              ResearchJob[]
  researchPointTransactions ResearchPointTransaction[]
  questProgress             PlayerQuestProgress[]
  onboardingState           PlayerOnboardingState?
  unitTrainingOrders        UnitTrainingOrder[]
  citySpyStates             CitySpyState[]
  spyTrainingJobs           SpyTrainingJob[]
  cityFleets                CityFleet[]
  navalTrainingJobs         NavalTrainingJob[]
  spyMissionsAttacking      SpyMission[]        @relation("SpyMissionAttacker")
  spyMissionsTargeted       SpyMission[]        @relation("SpyMissionTarget")
  spyCooldowns              SpyCooldown[]
  pveCampProgress           PlayerPveCampProgress[]
  analyticsEvents           GameAnalyticsEvent[]
  marketplaceOffersCreated  MarketplaceOffer[]        @relation("MarketplaceOffersCreated")
  marketplaceOffersAccepted MarketplaceOffer[]        @relation("MarketplaceOffersAccepted")
  allianceMembership        AllianceMember?
  allianceApplications      AllianceApplication[]
  allianceInvitations       AllianceInvitation[]      @relation("AllianceInvitationInvitees")
  sentAllianceInvitations   AllianceInvitation[]      @relation("AllianceInvitationInviters")
  allianceChatMessages      AllianceChatMessage[]
  allianceAnnouncements     AllianceAnnouncement[]
  allianceProjectsStarted   AllianceProject[]
  allianceDonations         AllianceDonation[]
  allianceProjectContributions AllianceProjectContribution[]
  allianceBonusesUnlocked   AllianceBonus[]                 @relation("AllianceBonusUnlockedBy")
  allianceHelpRequests      AllianceHelpRequest[]
  allianceTradeRequests     AllianceTradeRequest[]
  allianceSharedBattleReports AllianceSharedBattleReport[]
  allianceActivityEntries   AllianceActivityEntry[]
  liveEventParticipations   LiveEventParticipation[]
  moderation                PlayerModeration?
  moderationActions         PlayerModerationAction[]
  abuseSignals              AbuseSignal[]
  relatedAbuseSignals       AbuseSignal[]                  @relation("RelatedAbuseSignalPlayer")
  accountRiskSignals        AccountRiskSignal[]
  sensitiveActionAuditLogs  SensitiveActionAuditLog[]
  actionFrequencyCounters   ActionFrequencyCounter[]
  adminNotes                AdminPlayerNote[]
  adminWarnings             AdminPlayerWarning[]
  premiumWallet             PlayerPremiumWallet?
  premiumPurchases          PremiumPurchase[]
  premiumEntitlements       PremiumEntitlement[]
  premiumAuditLogs          PremiumAuditLog[]
  premiumLedgerEntries      PremiumLedgerEntry[]
  cosmeticInventoryItems    CosmeticInventoryItem[]
  inventoryItems            UserInventoryItem[]
  inventoryTransactions     InventoryTransaction[]
  equippedCosmetics         EquippedCosmetic[]
  supporterDonations        SupporterDonation[]
  donationAuditLogs         DonationAuditLog[]
  betaInviteUsages          BetaInviteUsage[]
  betaAllowlistUsages       BetaAllowlistUsage[]
  betaFeedback              BetaFeedback[]
  avatarFrame               String?
  premiumUntil              DateTime?

  @@unique([worldId, name])
  @@index([userId])
  @@index([worldId])
}

model City {
  id                         String   @id @default(uuid())
  worldId                    String
  playerId                   String
  islandId                   String?
  slotIndex                  Int?
  name                       String
  citySkin                   String?
  level                      Int      @default(1)
  population                 Int      @default(50)
  populationCapacity         Int      @default(100)
  happiness                  Int      @default(100)
  populationLastCalculatedAt DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  world                World                 @relation(fields: [worldId], references: [id])
  player               Player                @relation(fields: [playerId], references: [id])
  island               Island?               @relation(fields: [islandId], references: [id])
  resources            CityResource?
  buildings            CityBuilding[]
  workerAssignment     CityWorkerAssignment?
  transactions         ResourceTransaction[]
  reports              Report[]
  notificationDeliveries NotificationDelivery[]
  originMovements      Movement[]            @relation("OriginCityMovements")
  destinationMovements Movement[]            @relation("DestinationCityMovements")
  units                CityUnit[]
  unitTrainingOrders   UnitTrainingOrder[]
  spyState             CitySpyState?
  spyTrainingJobs      SpyTrainingJob[]
  fleet                CityFleet?
  navalTrainingJobs    NavalTrainingJob[]
  spyMissionsOrigin    SpyMission[]        @relation("SpyMissionOriginCity")
  spyMissionsTarget    SpyMission[]        @relation("SpyMissionTargetCity")
  marketplaceOffersCreated  MarketplaceOffer[] @relation("MarketplaceOfferCreatorCity")
  marketplaceOffersAccepted MarketplaceOffer[] @relation("MarketplaceOfferAcceptedCity")
  allianceDonations         AllianceDonation[]
  allianceHelpRequests      AllianceHelpRequest[]
  premiumEntitlements       PremiumEntitlement[]
  equippedCosmetics         EquippedCosmetic[]

  @@unique([islandId, slotIndex])
  @@unique([playerId, name])
  @@index([worldId])
  @@index([playerId])
  @@index([islandId])
}

model CityResource {
  cityId           String   @id
  wood             Int      @default(0)
  gold             Int      @default(0)
  marble           Int      @default(0)
  wine             Int      @default(0)
  crystal          Int      @default(0)
  sulfur           Int      @default(0)
  lastCalculatedAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id])
}

model CityBuilding {
  id                String    @id @default(uuid())
  cityId            String
  buildingType      String
  level             Int       @default(1)
  slotIndex         Int
  status            String    @default("idle")
  upgradeStartedAt  DateTime?
  upgradeFinishesAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, buildingType])
  @@index([cityId])
}

model CityWorkerAssignment {
  cityId        String   @id
  woodWorkers   Int      @default(5)
  goldWorkers   Int      @default(5)
  luxuryWorkers Int      @default(0)
  scientists    Int      @default(0)
  idleCitizens  Int      @default(40)
  updatedAt     DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id])
}

model PlayerResearchState {
  playerId                 String   @id
  worldId                  String
  researchPoints           Int      @default(0)
  researchLastCalculatedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@index([worldId])
}

model PlayerTechnology {
  id           String   @id @default(uuid())
  playerId     String
  worldId      String
  technologyId String
  status       String   @default("completed")
  completedAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@unique([playerId, technologyId])
  @@index([worldId])
  @@index([playerId])
  @@index([technologyId])
}

model ResearchJob {
  id           String    @id @default(uuid())
  worldId      String
  playerId     String
  technologyId String
  status       String    @default("active")
  startedAt    DateTime
  finishesAt   DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@index([worldId])
  @@index([playerId])
  @@index([technologyId])
  @@index([status])
  @@index([finishesAt])
}

model ResearchPointTransaction {
  id              String   @id @default(uuid())
  worldId         String
  playerId        String
  transactionType String
  amount          Int
  balanceAfter    Int
  referenceType   String?
  referenceId     String?
  createdAt       DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@index([worldId])
  @@index([playerId])
  @@index([transactionType])
}

model PlayerQuestProgress {
  id          String    @id @default(uuid())
  worldId     String
  playerId    String
  questId     String
  status      String    @default("locked")
  progress    Int       @default(0)
  target      Int       @default(1)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@unique([playerId, questId])
  @@index([worldId])
  @@index([playerId])
  @@index([status])
}

model PlayerOnboardingState {
  playerId             String   @id
  worldId              String
  hasCompletedTutorial Boolean  @default(false)
  currentQuestId       String?
  guideDismissed       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@index([worldId])
}

model ResourceTransaction {
  id              String   @id @default(uuid())
  worldId         String
  cityId          String
  playerId        String
  transactionType String
  resourceType    String
  amount          Int
  balanceAfter    Int
  referenceType   String?
  referenceId     String?
  createdAt       DateTime @default(now())

  city   City   @relation(fields: [cityId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  world  World  @relation(fields: [worldId], references: [id])

  @@index([worldId])
  @@index([cityId])
  @@index([playerId])
  @@index([transactionType])
  @@index([resourceType])
}

model Report {
  id        String   @id @default(uuid())
  worldId   String
  playerId  String
  cityId    String?
  type      String
  title     String
  message   String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  world  World  @relation(fields: [worldId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  city   City?  @relation(fields: [cityId], references: [id])
  notificationDeliveries NotificationDelivery[]

  @@index([worldId])
  @@index([playerId])
  @@index([cityId])
  @@index([type])
  @@index([isRead])
}

model Message {
  id                 String    @id @default(uuid())
  worldId            String
  senderPlayerId     String?
  recipientPlayerId  String
  messageType        String    @default("player")
  subject            String
  body               String
  isReadByRecipient  Boolean   @default(false)
  deletedBySender    Boolean   @default(false)
  deletedByRecipient Boolean   @default(false)
  createdAt          DateTime  @default(now())
  readAt             DateTime?

  world     World           @relation(fields: [worldId], references: [id])
  sender    Player?         @relation("SentPlayerMessages", fields: [senderPlayerId], references: [id])
  recipient Player          @relation("ReceivedPlayerMessages", fields: [recipientPlayerId], references: [id])
  reports   MessageReport[]
  notificationDeliveries NotificationDelivery[]

  @@index([worldId])
  @@index([senderPlayerId])
  @@index([recipientPlayerId])
  @@index([messageType])
  @@index([isReadByRecipient])
  @@index([createdAt])
}

model PlayerBlock {
  id              String   @id @default(uuid())
  worldId         String
  blockerPlayerId String
  blockedPlayerId String
  reason          String?
  createdAt       DateTime @default(now())

  world   World  @relation(fields: [worldId], references: [id])
  blocker Player @relation("BlockedPlayers", fields: [blockerPlayerId], references: [id])
  blocked Player @relation("BlockedPlayersTarget", fields: [blockedPlayerId], references: [id])

  @@unique([blockerPlayerId, blockedPlayerId])
  @@index([worldId])
  @@index([blockerPlayerId])
  @@index([blockedPlayerId])
}

model MessageReport {
  id               String    @id @default(uuid())
  worldId          String
  messageId        String
  reporterPlayerId String
  reason           String
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  world    World   @relation(fields: [worldId], references: [id])
  message  Message @relation(fields: [messageId], references: [id])
  reporter Player  @relation(fields: [reporterPlayerId], references: [id])

  @@unique([messageId, reporterPlayerId])
  @@index([worldId])
  @@index([messageId])
  @@index([reporterPlayerId])
  @@index([status])
}

model NotificationPreference {
  playerId              String   @id
  worldId               String
  inGameEnabled         Boolean  @default(true)
  emailEnabled          Boolean  @default(false)
  browserPushEnabled    Boolean  @default(false)
  constructionCompleted Boolean  @default(true)
  researchCompleted     Boolean  @default(true)
  tradeArrived          Boolean  @default(true)
  armyReturned          Boolean  @default(true)
  incomingAttack        Boolean  @default(true)
  allianceMessage       Boolean  @default(true)
  warehouseFull         Boolean  @default(true)
  eventEnding           Boolean  @default(true)
  quietHoursStart       Int?
  quietHoursEnd         Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  world  World  @relation(fields: [worldId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([worldId])
}

model BrowserPushSubscription {
  id        String   @id @default(uuid())
  worldId   String
  playerId  String
  userId    String
  endpoint  String   @unique
  p256dh     String
  auth      String
  userAgent String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  world  World  @relation(fields: [worldId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([worldId])
  @@index([playerId])
  @@index([userId])
  @@index([enabled])
}

model NotificationDelivery {
  id          String    @id @default(uuid())
  worldId     String
  playerId    String
  cityId      String?
  reportId    String?
  messageId   String?
  type        String
  channel     String
  status      String    @default("pending")
  title       String
  body        String
  scheduledAt DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  world   World   @relation(fields: [worldId], references: [id])
  player  Player  @relation(fields: [playerId], references: [id])
  city    City?   @relation(fields: [cityId], references: [id])
  report  Report? @relation(fields: [reportId], references: [id])
  message Message? @relation(fields: [messageId], references: [id])

  @@unique([reportId, channel])
  @@unique([messageId, channel])
  @@index([worldId])
  @@index([playerId])
  @@index([cityId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([archivedAt])
  @@index([createdAt])
}

model Alliance {
  id          String    @id @default(uuid())
  worldId     String
  name        String
  tag         String
  description String   @default("")
  status      String   @default("active")
  bannerCosmetic String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world         World                  @relation(fields: [worldId], references: [id])
  members       AllianceMember[]
  applications  AllianceApplication[]
  invitations   AllianceInvitation[]
  chatMessages  AllianceChatMessage[]
  announcements AllianceAnnouncement[]
  treasury      AllianceTreasury?
  donations     AllianceDonation[]
  projects      AllianceProject[]
  projectContributions AllianceProjectContribution[]
  bonuses       AllianceBonus[]
  helpRequests  AllianceHelpRequest[]
  tradeRequests AllianceTradeRequest[]
  sharedBattleReports AllianceSharedBattleReport[]
  activityEntries AllianceActivityEntry[]
  premiumEntitlements PremiumEntitlement[]
  equippedCosmetics   EquippedCosmetic[]

  @@unique([worldId, name])
  @@unique([worldId, tag])
  @@index([worldId])
  @@index([status])
}

model AllianceMember {
  id         String   @id @default(uuid())
  worldId    String
  allianceId String
  playerId   String   @unique
  role       String   @default("member")
  contributionScore Int @default(0)
  joinedAt   DateTime @default(now())

  world    World    @relation(fields: [worldId], references: [id])
  alliance Alliance @relation(fields: [allianceId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])

  @@unique([allianceId, playerId])
  @@index([worldId])
  @@index([allianceId])
  @@index([role])
}

model AllianceTreasury {
  allianceId String   @id
  worldId    String
  wood       Int      @default(0)
  gold       Int      @default(0)
  marble     Int      @default(0)
  wine       Int      @default(0)
  crystal    Int      @default(0)
  sulfur     Int      @default(0)
  updatedAt  DateTime @updatedAt

  world    World    @relation(fields: [worldId], references: [id])
  alliance Alliance @relation(fields: [allianceId], references: [id])

  @@index([worldId])
}

model AllianceDonation {
  id         String   @id @default(uuid())
  worldId    String
  allianceId String
  playerId   String
  cityId     String
  projectId  String?
  wood       Int      @default(0)
  gold       Int      @default(0)
  marble     Int      @default(0)
  wine       Int      @default(0)
  crystal    Int      @default(0)
  sulfur     Int      @default(0)
  contributionScore Int @default(0)
  createdAt  DateTime @default(now())

  world    World    @relation(fields: [worldId], references: [id])
  alliance Alliance @relation(fields: [allianceId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  city     City     @relation(fields: [cityId], references: [id])
  project  AllianceProject? @relation(fields: [projectId], references: [id])

  @@index([worldId])
  @@index([allianceId])
  @@index([playerId])
  @@index([cityId])
  @@index([projectId])
  @@index([createdAt])
}

model AllianceProject {
  id         String   @id @default(uuid())
  worldId    String
